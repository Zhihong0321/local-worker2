# Form Worker settings. Copy to worker.env (in this folder) and fill in. Keep worker.env private:
# the key lets this machine take website and form jobs from the hub.
LAB_URL=https://ee-auto.up.railway.app
GMAP_WORKER_KEY=
# LAB_TOKEN=                 (only on a machine that already holds it; GMAP_WORKER_KEY is enough otherwise)
# WORKER_NAME=form-mac-mini
# FORM_JOBS=scan,send        (scan = check websites, send = fill contact forms; one of them alone is fine)
# CONCURRENCY=6              (websites checked at once)
# SEND_LANES=4               (forms filled at once)
# CHROME_PATH=               (the browser for sending; empty = the usual Chrome or Edge install)
